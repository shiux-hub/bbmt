{
  "name": "bbmt",
  "displayName": "BBMT",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.6.3",
  "description": "Browser bookmark management tool",
  "author": "Dropout",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --max-warnings 0 --fix",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "dependencies": {
    "@douyinfe/semi-icons": "^2.76.0",
    "@douyinfe/semi-icons-lab": "^2.76.0",
    "@douyinfe/semi-ui": "^2.76.0",
    "axios": "^1.8.3",
    "plasmo": "0.90.3",
    "radash": "^12.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.10.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/cz-commitlint": "^19.8.0",
    "@commitlint/prompt-cli": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "@eslint-react/eslint-plugin": "^1.34.1",
    "@types/chrome": "0.0.309",
    "@types/node": "22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "npm:eslint-ts-patch@9.8.0-1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-ts-patch": "9.8.0-1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.14",
    "typescript": "5.8.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{scss,css,vue,ts,md}": [
      "eslint --fix"
    ]
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "bookmarks"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
